#Data Generation

import numpy as np
import pandas as pd

np.random.seed(1)
n =1000

F = np.random.uniform(100, 1000, n)        # Load (N)
L = np.random.uniform(1, 10, n)            # Length (m)
E = np.random.uniform(1e9, 2e11, n)        # Young's modulus (Pa)
I = np.random.uniform(1e-6, 1e-4, n)       # Moment of inertia (m^4)

delta = (F * L**3) / (3 * E * I)
delta = np.abs(delta*(1+ np.random.normal(0,0.5,n)))

data = pd.DataFrame({
    'Force' : F, 'Length':L,'Youngs Modulus':E,'Inertia':I,'Deflection':delta})
data.head()

  #Model training

from sklearn.model_selection import train_test_split
from sklearn.ensemble import RandomForestRegressor

X = data.drop('Deflection', axis =1)
Y = np.log(data['Deflection'])

X_train,X_test, Y_train, Y_test = train_test_split(X,Y,test_size=0.2, random_state =1)

model = RandomForestRegressor(n_estimators=100)
model.fit(X_train, Y_train)

y_pred = model.predict(X_test)
 
from sklearn.metrics import r2_score

print(r2_score(Y_test, y_pred))

#Pictoral Representation

import matplotlib.pyplot as plt

plt.scatter(Y_test,y_pred,alpha = 0.5)
plt.xlabel("Actual")
plt.ylabel("Predicted")
plt.title("Actual vs Predicted(with noise)")
plt.show()
